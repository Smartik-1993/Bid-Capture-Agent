# ==============================================================================
# AI Bid Capture Agent - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your API keys before running:
# cp .env.example .env

# Google Gemini API Key (Required for live AI extraction, summarization, and interactive Q&A)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# SAM.gov API Key (Optional - for live querying of Federal solicitations)
# Get a key at: https://sam.gov/
# If left empty, realistic live-simulated federal RFPs will be generated
SAM_GOV_API_KEY=your_sam_gov_api_key_here
